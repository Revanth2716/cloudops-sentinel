# Local development only. Replace these values for any shared environment.
PORT=3001
FRONTEND_ORIGIN=http://127.0.0.1:5173

# Use these demo tokens in the dashboard login. They are not production secrets.
LOCAL_OPERATOR_TOKEN=cloudops-local-operator-change-me
LOCAL_VIEWER_TOKEN=cloudops-local-viewer-change-me

DATABASE_PATH=./data/cloudops.db
SLOW_RESPONSE_MS=1000
UNHEALTHY_INCIDENT_SEVERITY=high
HEALTH_SIGNAL_RETENTION_DAYS=30

# Advisory AI is disabled by default. No Ollama installation is needed locally.
AI_ENABLED=false
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT_MS=15000

# Release-readiness boundary: the only supported execution mode is dry_run.
REMEDIATION_MODE=dry_run
